{
  "name": "phonemail-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm run build:api && npm run build:web",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "prisma:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "prisma:seed": "npx tsx ./prisma/seed.ts",
    "prisma:postgresql": "node ./scripts/prepare-prisma.js postgresql && npx prisma generate --schema=./prisma/schema.prisma",
    "prisma:sqlite": "node ./scripts/prepare-prisma.js sqlite && npx prisma generate --schema=./prisma/schema.prisma",
    "render:api-build": "node ./scripts/prepare-prisma.js postgresql && npx prisma generate --schema=./prisma/schema.prisma && npx prisma db push --schema=./prisma/schema.prisma --accept-data-loss && npx tsx ./prisma/seed.ts && npm run build:api",
    "render:api-start": "node apps/api/dist/index.js",
    "test": "npx tsx ./test-suite.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.10.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
